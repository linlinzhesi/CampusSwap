# ============================================================
# .gitignore
# 作用：告诉 Git 哪些文件/目录「不要提交」到仓库
# 好处：避免把虚拟环境、缓存、密钥等不该上传的东西提交上去
# ============================================================

# Python 缓存（__pycache__ 是 Python 自动生成的编译缓存，没必要提交）
__pycache__/
*.py[cod]
*.egg-info/

# 虚拟环境（venv 里装了一堆依赖，体积大，且别人用 requirements.txt 自己装即可）
venv/
.venv/
env/

# 环境变量文件（可能含密钥，绝不能提交）
.env

# IDE 配置（每个人 IDE 不同，不用提交）
.idea/
.vscode/
*.swp

# 数据库文件（本地数据库不用提交）
*.db
*.sqlite3

# 系统文件
.DS_Store
Thumbs.db
